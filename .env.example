# quant-biga 配置模板 —— 复制成 .env 后填值。
# .env 已在 .gitignore 里，**永远不要提交**。
#
# 只列需要你决定的项；其余默认值和"为什么是这个值"的理由都在
# src/qbg/config.py 里，改参数前先读那里的注释。

# ======================================================================
# 运行模式
# ======================================================================
# ADVISORY = 只出下单清单，零券商接触（本期唯一实现的模式）
# PAPER    = 模拟盘   LIVE = 实盘
QBG_MODE=ADVISORY

# 实盘的三把锁之一。另外两把：QBG_MODE=LIVE，以及
# configs/risk_limits.yaml 里的 allow_live_mode: true。三把都开才会真下单。
I_CONFIRM_REAL=0

# ======================================================================
# 数据源
# ======================================================================
# 降级链顺序：主源失败/返回空就顺次往后退。
QBG_DATA_SOURCES=baostock,akshare
QBG_INGEST_MAX_WORKERS=4
QBG_HISTORY_START=2020-01-01

# 预留。tushare 新账号 0 积分，日线要 120 积分起且只给不复权，本期不用。
TUSHARE_TOKEN=

# ======================================================================
# 股票池与策略
# ======================================================================
QBG_INDEX_CODE=000300        # 沪深300
QBG_TOP_K=3                  # 10万账户：单槽约3万 → 一手上限约300元/股
QBG_KEEP_RANK=15             # 迟滞：持仓股在前15名内就保留，降换手
QBG_REBALANCE_EVERY_DAYS=10  # ≈两周。成本是小账户头号敌人，别调低
QBG_MARKET_SMA=20            # 2020–2026 四窗口压测：Sharpe最高且回撤并列最低
QBG_ENSEMBLE_SEEDS=3
QBG_INDUSTRY_NEUTRAL=1
QBG_MIN_LIST_DAYS=60         # 次新股过滤，顺带规避新股涨跌幅特殊规则
QBG_EXCLUDE_ST=1

# ======================================================================
# 持仓来源
# ======================================================================
# ocr = 读 tools/ocr_positions.py 产出的 CSV
# manual = 同一份 CSV 手工编辑（不想把截图传给 LLM 就用这个）
QBG_PORTFOLIO_SOURCE=ocr

# ======================================================================
# 第三方中转站（OpenAI-compatible /v1/chat/completions）
# ======================================================================
# base_url 通常以 /v1 结尾；模型 id 以中转站控制台实际显示为准。
# 不要把 key 发到聊天或提交 Git，只在本机 .env 填写。
QBG_LLM_BASE_URL=https://YOUR_RELAY_HOST/v1
QBG_LLM_API_KEY=
# 推荐：复盘/最终判断用 gpt-4o，批量分析与 OCR 用 gpt-4o-mini。
# 如果中转站对模型做了命名空间映射（如 openai/gpt-4o），按它的 id 改。
QBG_LLM_MODEL=gpt-4o
QBG_LLM_MODEL_QUICK=gpt-4o-mini
QBG_LLM_TIMEOUT_SECONDS=90

# ======================================================================
# 多模态读图（P5，可选覆盖）
# ======================================================================
# 留空即复用上面的 URL/key/quick model。⚠ 启用后持仓截图会上传到中转站。
# --- 同花顺官方金融数据 API（fuyao.aicubes.cn）---
# **只有数据，没有下单。** 下单仍走 easytrader + pywinauto（CLAUDE.md §七）。
#
# 用途只有一个：下单前拿**当日**真实参考价（盘中快照 / 集合竞价定价），
# 替代 parquet 缓存里的昨收。实测 0.2% 让价配昨收时，37.7% 的卖单会挂到
# 市价错误的一侧（表见 configs/risk_limits.yaml）。
#
# **留空 = 这条增强不启用**，限价退回用缓存收盘价，并自动改用更宽的
# order_slippage_stale_pct。注册见 https://fuyao.aicubes.cn/
FUYAO_API_KEY=

QBG_VISION_BASE_URL=
QBG_VISION_API_KEY=
QBG_VISION_MODEL=

# ======================================================================
# TradingAgents 逐票复核（P7）
# ======================================================================
QBG_AGENTS_ENABLED=1         # 只作复核闸；主信号仍来自 qlib，异常按 FAIL_OPEN 放行
QBG_AGENTS_MIN_RATING=Hold   # k=3 时卡 Overweight 会经常填不满槽位
QBG_AGENTS_CANDIDATES=9      # 复核 top9 而非只复核 k=3 个，留出被砍的余量
QBG_AGENTS_FAIL_OPEN=1       # LLM 挂了退回纯量化信号，而不是整天不交易
QBG_AGENTS_RENORMALIZE=1

# provider、backend、key 和模型由 QBG_LLM_* 自动映射到 TradingAgents 的
# openai_compatible provider；不要再写 TRADINGAGENTS_LLM_PROVIDER=openai，
# 否则它会改走很多中转站没有实现的 /v1/responses。
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OUTPUT_LANGUAGE=中文
TRADINGAGENTS_TEMPERATURE=0

# ======================================================================
# 复盘调参 agent（P8）
# ======================================================================
QBG_AGENT_ENABLED=0          # URL/key 填好并通过 24_llm_check --probe 后改 1
QBG_AGENT_AUTOAPPLY=0        # 0 = agent 只能提议，人来批
QBG_AGENT_MAX_TOKENS=3072
QBG_AGENT_TEMPERATURE=0.1
QBG_AGENT_JSON_MODE=1        # 中转不支持 response_format=json_object 时改 0

# ======================================================================
# 邮件通知（只出站）
# ======================================================================
# 日流程结束后把同一份 Markdown 日报作为纯文本 + HTML 邮件发送；SMTP 失败不影响
# 清单和进程结果。密码应使用邮箱服务商生成的应用专用密码，不是账户登录密码。
NOTIFY_EMAIL_ENABLED=0
SMTP_HOST=                   # 例如 smtp.gmail.com / smtp.163.com
SMTP_PORT=587                # 465/8465=隐式 TLS；其他端口走 STARTTLS
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=             # 留空时发给 SMTP_USER

# --- 入站邮件命令通道（可选，默认关闭）---
# 回复日报即可触发 重跑 / 状态 / 关机。三道关卡：白名单 + 一次性令牌 + 命令词唯一。
# 令牌才是鉴权（发件地址可伪造），它只出现在发往你自己邮箱的那封信的主题里。
EMAIL_COMMANDS_ENABLED=0
# ⚠ 监听器登录的是**发信邮箱**（SMTP_USER），所以要和 SMTP 同一家。
#    SMTP_HOST=smtp.163.com  →  IMAP_HOST=imap.163.com
#    163 还需在邮箱设置里开启 IMAP，并用「授权码」而不是登录密码。
IMAP_HOST=
IMAP_PORT=993
# 允许下命令的地址，逗号分隔。留空会回退到收件人，但生产环境请显式写死。
EMAIL_COMMAND_ALLOWLIST=
EMAIL_LISTENER_POLL_SEC=60
# 监听器最长存活小时数。必须有上限：它每天日流程结束后拉起，
# 而一个整天挂着的入站通道是不必要的攻击面。
EMAIL_LISTENER_MAX_HOURS=3
